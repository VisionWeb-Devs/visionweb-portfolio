{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "A piece of work in the portfolio. Covers both client projects and VisionWeb's own products."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "client": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "problem": {
      "type": "text"
    },
    "solution": {
      "type": "text"
    },
    "liveUrl": {
      "type": "string"
    },
    "isInternal": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "techStack": {
      "type": "component",
      "repeatable": true,
      "component": "shared.label"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.label"
    },
    "screenshots": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
