{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package",
    "description": "A pricing tier. Price is numeric with a separate currency so it can be formatted per locale rather than baked into a string."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "price": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "DZD",
      "required": true,
      "maxLength": 3,
      "minLength": 3
    },
    "priceIsFrom": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.label"
    }
  }
}
