# Copy to .env and fill in. Generate each secret with: openssl rand -base64 32

# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database
# NOTE: DATABASE_FILENAME must be set explicitly. `create-strapi` in
# non-interactive mode writes it empty, and an empty value is NOT the same as
# an unset one — the default never kicks in, the path resolves to the project
# directory, and Strapi fails to boot with "unable to open database file".
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production uses PostgreSQL instead:
# DATABASE_CLIENT=postgres
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_SSL=true

# Webhook secret for Next.js on-demand revalidation. Must match
# REVALIDATE_SECRET in web/.env.local.
WEBHOOK_TOKEN=

# Media upload provider (Cloudflare R2 via the official S3 provider).
# Leave unset in development to use local disk storage.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_URL=
