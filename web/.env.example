# Strapi ---------------------------------------------------------------------
# Base URL of the Strapi instance, with no trailing slash.
STRAPI_URL=http://localhost:1337

# Read-only API token from Strapi: Settings -> API Tokens.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
STRAPI_API_TOKEN=

# Shared secret for the Strapi webhook that triggers on-demand revalidation.
# Set the same value in Strapi: Settings -> Webhooks -> Authorization header,
# as `Bearer <value>`. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Media ----------------------------------------------------------------------
# Public hostname serving uploaded media in production, e.g. the R2 bucket
# domain. Leave unset locally; media is served from STRAPI_URL in development.
MEDIA_HOSTNAME=
