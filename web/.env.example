# Site -----------------------------------------------------------------------
# Production origin, no trailing slash. Drives canonical URLs, Open Graph
# tags, the sitemap and robots.txt, so these are all wrong until it is set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi ---------------------------------------------------------------------
# Base URL of the Strapi instance, with no trailing slash.
STRAPI_URL=http://localhost:1337

# Read-only API token from Strapi: Settings -> API Tokens.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
STRAPI_API_TOKEN=

# Shared secret for the Strapi webhook that triggers on-demand revalidation.
# Set the same value in Strapi: Settings -> Webhooks -> Authorization header,
# as `Bearer <value>`. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Media ----------------------------------------------------------------------
# Lets next/image fetch from localhost and private IPs. Needed only to test a
# production build against a local Strapi, because Next 16 blocks local
# addresses by default and returns 400 for every image.
# SSRF risk — never set this anywhere the site is publicly reachable.
ALLOW_LOCAL_IMAGES=false

# Public hostname serving uploaded media in production, e.g. the R2 bucket
# domain. Leave unset locally; media is served from STRAPI_URL in development.
MEDIA_HOSTNAME=
