# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are intentionally unanchored so they apply in both web/ and cms/.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# production
build

# strapi
cms/.tmp
cms/.cache
cms/build
cms/dist
cms/.strapi
cms/exports
cms/*.db

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# vercel
.vercel
