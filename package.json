{
  "name": "visionweb",
  "private": true,
  "description": "VisionWeb Devs monorepo: web/ is the Next.js site, cms/ is the Strapi backend.",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix web",
    "lint": "npm run lint --prefix web",
    "typecheck": "npm run typecheck --prefix web",
    "cms:dev": "npm run develop --prefix cms",
    "cms:build": "npm run build --prefix cms",
    "cms:types": "npm run strapi --prefix cms -- ts:generate-types"
  }
}
